{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "slideforge",
  "compatibility_date": "2026-09-01",
  "routes": [
    {
      "pattern": "slideforge.woodleigh.vic.edu.au",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
