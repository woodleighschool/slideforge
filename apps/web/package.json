{
  "name": "@slideforge/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run types && vite",
    "build": "pnpm run types && tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "lint": "oxlint . && pnpm run typecheck",
    "lint:fix": "oxlint --fix . && pnpm run typecheck",
    "typecheck": "pnpm run types && tsc -b",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "types": "wrangler types --include-runtime false"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@slideforge/core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.36.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  }
}
